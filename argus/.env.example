# ── Argus configuration ──────────────────────────────────────────────
# Copy to .env.local (next dev/start reads it) or set in the systemd unit.

# The decision engine. Without this Argus runs the mock engine and the
# dashboard shows a warning banner.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: benchmark a cheaper tier against your golden set before
# switching (default: claude-opus-4-8).
# ARGUS_TRIAGE_MODEL=claude-sonnet-5

# Google OAuth (console.cloud.google.com — consent screen MUST be
# "In production", see README).
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REDIRECT_URI=http://argus.local:3000/api/auth/callback

# Single-user auth. Generate with: openssl rand -hex 24
# Then visit http://argus.local:3000/?key=<value> once per browser.
ARGUS_SECRET=

# Scheduling (defaults shown). ARGUS_CRON=0 disables.
# ARGUS_BRIEF_CRON=0 7 * * *
# ARGUS_REFLECT_CRON=30 3 * * *
# ARGUS_HORIZON_CRON=0 18 * * 0        # weekly life-expansion scan (Sun 6pm)
ARGUS_TZ=America/Los_Angeles

# Your home city — makes Horizons travel/local suggestions relevant.
# ARGUS_LOCATION=Portland, OR

# Database path. Use an absolute path under systemd.
# ARGUS_DB=/var/lib/argus/argus.db
