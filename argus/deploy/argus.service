# Argus systemd unit — /etc/systemd/system/argus.service
#
#   sudo useradd -r -m -d /var/lib/argus argus     # once
#   sudo cp deploy/argus.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now argus
#   journalctl -u argus -f                          # watch the scheduler log

[Unit]
Description=Argus — personal AI chief of staff
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=argus
# Clone lives here; run `npm ci && npm run build` in it after every update.
WorkingDirectory=/var/lib/argus/app/argus
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

# Timezone matters: the 7am brief fires in THIS timezone.
# Keep it identical to ARGUS_TZ in argus.env.
Environment=TZ=America/Los_Angeles
Environment=NODE_ENV=production
# ALL other config — including ARGUS_DB — lives in the env file, so the
# preflight (`npm run doctor` with that file loaded) checks the exact same
# database path the service will use. Don't duplicate vars here.
#   sudo install -m 600 -o argus /dev/null /var/lib/argus/argus.env
#   (put ANTHROPIC_API_KEY, GOOGLE_*, ARGUS_SECRET, ARGUS_TZ, ARGUS_DB there)
EnvironmentFile=/var/lib/argus/argus.env

# Hardening (safe defaults for a home box)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/argus

[Install]
WantedBy=multi-user.target
